# Copie este arquivo para ".env" (cp .env.example .env) e troque a senha.
# O arquivo ".env" nao e versionado.
#
# Ele e usado em dois lugares:
#   1) pelo docker compose, para criar o SQL Server;
#   2) pelo build do app Android, para saber como conectar ao banco.

# Senha do usuario sa do SQL Server.
# Regras: minimo de 8 caracteres e pelo menos 3 destas categorias:
# maiuscula, minuscula, numero e simbolo.
MSSQL_SA_PASSWORD=Troque-Esta-Senha-123

# Endereco do computador onde o SQL Server roda, visto pelo app.
# - Emulador Android: deixe comentado (o padrao 10.0.2.2 ja aponta para o computador).
# - Celular real: tire o "#" e coloque o IP do computador na rede local
#   (veja com "ip -4 addr" no Linux ou "ipconfig" no Windows).
#   O celular e o computador precisam estar na mesma rede.
# BARBERFLOW_DB_HOST=192.168.0.10
